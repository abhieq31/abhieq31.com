---
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`404 Not Found | ${SITE.title}`}
  description="Page not found."
>
  <Header />
  <main id="main-content" class="site-shell not-found">
    <h1 class="page-title">404</h1>
    <p class="page-desc">Page not found.</p>
    <p>
      <a href="/" class="red-link">Go back home</a>
    </p>
  </main>
</Layout>

<style>
  .not-found {
    padding-top: 80px;
    padding-bottom: 120px;
  }

  .page-title {
    margin: 0 0 12px;
    font-size: 40px;
    font-weight: 700;
    color: #fff;
  }

  .page-desc {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 18px;
  }
</style>
