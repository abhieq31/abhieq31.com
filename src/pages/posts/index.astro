---
import { getCollection } from "astro:content";
import Header from "@/components/Header.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = getSortedPosts(posts);

// Top posts: featured first, else newest
const featured = sorted.filter(p => p.data.featured);
const topPosts = (featured.length ? featured : sorted).slice(0, 5);

const byYear = Object.entries(
  getPostsByGroupCondition(posts, post => {
    const pubDate = post.data.pubDatetime || new Date();
    return new Date(pubDate).getFullYear();
  }),
).sort(([a], [b]) => Number(b) - Number(a));

// Client-side search payload
const searchIndex = sorted.map(p => ({
  title: p.data.title,
  path: getPath(p.id, p.filePath),
  year: new Date(p.data.pubDatetime).getFullYear(),
  subtitle: p.data.subtitle || "",
  description: p.data.description || "",
}));
---

<Layout
  title={`Archive | ${SITE.title}`}
  description="Archive of all writing by Abhi."
>
  <Header />
  <main id="main-content" class="site-shell archive-page">
    <h1 class="archive-title">Archive</h1>

    <div class="archive-search">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        id="archive-search-input"
        placeholder="Search…"
        autocomplete="off"
        aria-label="Search posts"
      />
    </div>

    <div id="archive-default">
      {
        topPosts.length > 0 && (
          <section class="archive-section" aria-labelledby="top-posts-heading">
            <h2 id="top-posts-heading" class="section-label">
              Top Posts
            </h2>
            <ul class="title-list">
              {topPosts.map(p => (
                <li>
                  <a href={getPath(p.id, p.filePath)}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        byYear.map(([year, yearGroup]) => {
          const items = [...yearGroup].sort(
            (a, b) =>
              new Date(b.data.pubDatetime).getTime() -
              new Date(a.data.pubDatetime).getTime(),
          );
          return (
            <section class="archive-section" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`} class="section-label">
                {year}
              </h2>
              <ul class="title-list">
                {items.map(p => (
                  <li>
                    <a href={getPath(p.id, p.filePath)}>{p.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>

    <div id="archive-results" class="archive-section" hidden>
      <h2 class="section-label">Results</h2>
      <ul id="archive-results-list" class="title-list"></ul>
      <p id="archive-empty" class="archive-empty" hidden>No matching posts.</p>
    </div>
  </main>
</Layout>

<script define:vars={{ searchIndex }}>
  function initArchiveSearch() {
    const input = document.getElementById("archive-search-input");
    const defaults = document.getElementById("archive-default");
    const results = document.getElementById("archive-results");
    const list = document.getElementById("archive-results-list");
    const empty = document.getElementById("archive-empty");
    if (!input || !defaults || !results || !list || !empty) return;

    const render = (q) => {
      const query = (q || "").trim().toLowerCase();
      if (!query) {
        defaults.hidden = false;
        results.hidden = true;
        list.innerHTML = "";
        empty.hidden = true;
        return;
      }

      const matches = searchIndex.filter((p) => {
        const hay = `${p.title} ${p.subtitle} ${p.description}`.toLowerCase();
        return hay.includes(query);
      });

      defaults.hidden = true;
      results.hidden = false;
      list.innerHTML = matches
        .map((p) => `<li><a href="${p.path}">${p.title}</a></li>`)
        .join("");
      empty.hidden = matches.length > 0;
    };

    input.addEventListener("input", (e) => {
      render(e.target.value);
    });
  }

  initArchiveSearch();
</script>
