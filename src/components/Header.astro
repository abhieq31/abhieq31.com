---
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const isArchive = currentPath === "/posts" || currentPath.startsWith("/posts/");
---

<header class="site-header">
  <a
    id="skip-to-content"
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-background focus:px-3 focus:py-2 focus:text-accent"
  >
    Skip to content
  </a>

  <div class="site-shell header-inner">
    <a href="/" class="site-logo" aria-label={`${SITE.title} home`}>
      {SITE.title}
    </a>

    <nav class="site-nav" aria-label="Primary">
      <!-- Default nav links -->
      <div id="nav-links" class="nav-links">
        <a href="/posts" class:list={[{ "is-active": isArchive }]}>Archive</a>
        <a href="https://x.com/abhieq31" target="_blank" rel="me noopener">X</a>
        <a href="https://github.com/abhieq31" target="_blank" rel="me noopener"
          >GitHub</a
        >
        <button type="button" id="subscribe-open" class="nav-btn">
          Subscribe
        </button>
      </div>

      <!-- Inline subscribe form (nav.al pattern) -->
      <div id="subscribe-box" class="subscribe-box" hidden>
        <form class="subscribe-form" id="subscribe-form">
          <input
            type="email"
            name="email"
            id="subscribe-email"
            placeholder="Email"
            required
            autocomplete="email"
            aria-label="Email address"
          />
          <button type="submit">Subscribe</button>
        </form>
        <button type="button" id="subscribe-cancel" class="subscribe-cancel">
          Cancel
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 40px 0 28px;
    width: 100%;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .site-logo {
    font-size: 22px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .site-logo:hover {
    color: var(--accent-hover);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 39px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-links a,
  .nav-btn {
    color: var(--muted-nav);
    font-size: 16px;
    line-height: 22px;
    font-weight: 500;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
  }

  .nav-links a:hover,
  .nav-btn:hover,
  .nav-links a.is-active {
    color: #fff;
  }

  .subscribe-box {
    display: flex;
    align-items: center;
  }

  .subscribe-box[hidden] {
    display: none;
  }

  @media (max-width: 520px) {
    .nav-links {
      gap: 12px;
    }

    .nav-links a,
    .nav-btn {
      font-size: 14px;
    }

    .site-logo {
      font-size: 20px;
    }
  }
</style>

<script>
  function setupSubscribe() {
    const openBtn = document.getElementById("subscribe-open");
    const cancelBtn = document.getElementById("subscribe-cancel");
    const box = document.getElementById("subscribe-box");
    const links = document.getElementById("nav-links");
    const form = document.getElementById(
      "subscribe-form",
    ) as HTMLFormElement | null;
    const email = document.getElementById(
      "subscribe-email",
    ) as HTMLInputElement | null;

    if (!openBtn || !cancelBtn || !box || !links) return;

    const show = () => {
      links.setAttribute("hidden", "");
      box.removeAttribute("hidden");
      email?.focus();
    };

    const hide = () => {
      box.setAttribute("hidden", "");
      links.removeAttribute("hidden");
    };

    openBtn.addEventListener("click", show);
    cancelBtn.addEventListener("click", hide);

    // Newsletter provider not wired yet — keep the nav.al UI.
    // After submit, thank the reader and leave them on the page.
    form?.addEventListener("submit", e => {
      e.preventDefault();
      const value = email?.value?.trim();
      if (!value) return;
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.textContent = "Subscribed";
      setTimeout(() => {
        if (submitBtn) submitBtn.textContent = "Subscribe";
        form.reset();
        hide();
      }, 1200);
    });
  }

  setupSubscribe();
  document.addEventListener("astro:after-swap", setupSubscribe);
</script>
