---
import { SITE } from "@/config";

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const isArchive = currentPath === "/posts" || currentPath.startsWith("/posts/");

// Optional: set PUBLIC_NEWSLETTER_ACTION in Vercel env to a Formspree/Buttondown URL.
// Example Formspree: https://formspree.io/f/xxxxxxxx
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION || "";
---

<header class="site-header">
  <a
    id="skip-to-content"
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-background focus:px-3 focus:py-2 focus:text-accent"
  >
    Skip to content
  </a>

  <div class="page-gutter header-inner">
    <a href="/" class="site-logo" aria-label={`${SITE.title} home`}>
      {SITE.title}
    </a>

    <nav class="site-nav" aria-label="Primary">
      <div id="nav-links" class="nav-links">
        <a href="/posts" class:list={[{ "is-active": isArchive }]}>Archive</a>
        <a href="/deskmate" title="Deskmate: play chess with a colleague">Chess</a>
        <a href="https://x.com/abhieq31" target="_blank" rel="me noopener">X</a>
        <a
          href="https://www.instagram.com/abhieq31/"
          target="_blank"
          rel="me noopener">Instagram</a
        >
        <a href="https://github.com/abhieq31" target="_blank" rel="me noopener"
          >GitHub</a
        >
        <button type="button" id="subscribe-open" class="nav-btn">
          Subscribe
        </button>
      </div>

      <div id="subscribe-box" class="subscribe-box" hidden>
        <form
          class="subscribe-form"
          id="subscribe-form"
          method="POST"
          data-has-backend={newsletterAction ? "true" : "false"}
          action={newsletterAction || undefined}
        >
          <input
            type="email"
            name="email"
            id="subscribe-email"
            placeholder="Email"
            required
            autocomplete="email"
            aria-label="Email address"
          />
          {
            newsletterAction && (
              <input type="hidden" name="_subject" value="abhieq31.com subscribe" />
            )
          }
          <button type="submit">Subscribe</button>
        </form>
        <button type="button" id="subscribe-cancel" class="subscribe-cancel">
          Cancel
        </button>
      </div>
    </nav>
  </div>
</header>

<div id="subscribe-note" class="subscribe-note" hidden role="status"></div>

<script>
  function setupSubscribe() {
    const openBtn = document.getElementById("subscribe-open");
    const cancelBtn = document.getElementById("subscribe-cancel");
    const box = document.getElementById("subscribe-box");
    const links = document.getElementById("nav-links");
    const form = document.getElementById(
      "subscribe-form",
    ) as HTMLFormElement | null;
    const email = document.getElementById(
      "subscribe-email",
    ) as HTMLInputElement | null;
    const note = document.getElementById("subscribe-note");

    if (!openBtn || !cancelBtn || !box || !links || !form) return;

    // Avoid double-binding after re-runs
    if (form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const show = () => {
      links.setAttribute("hidden", "");
      box.removeAttribute("hidden");
      email?.focus();
    };

    const hide = () => {
      box.setAttribute("hidden", "");
      links.removeAttribute("hidden");
    };

    const showNote = (html: string) => {
      if (!note) return;
      note.innerHTML = html;
      note.removeAttribute("hidden");
      window.setTimeout(() => {
        note.setAttribute("hidden", "");
      }, 6000);
    };

    openBtn.addEventListener("click", show);
    cancelBtn.addEventListener("click", hide);

    form.addEventListener("submit", async e => {
      const hasBackend = form.dataset.hasBackend === "true";
      const value = email?.value?.trim();
      if (!value) {
        e.preventDefault();
        return;
      }

      // No newsletter provider configured yet — don't pretend it worked.
      if (!hasBackend) {
        e.preventDefault();
        hide();
        form.reset();
        showNote(
          "Thanks — email list isn’t connected yet. For now, use the <a href=\"/rss.xml\">RSS feed</a> or follow on <a href=\"https://x.com/abhieq31\" target=\"_blank\" rel=\"noopener\">X</a> / <a href=\"https://www.instagram.com/abhieq31/\" target=\"_blank\" rel=\"noopener\">Instagram</a>.",
        );
        return;
      }

      // With Formspree/Buttondown action: allow normal POST, or fetch for SPA feel
      e.preventDefault();
      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "…";
      }
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error("subscribe failed");
        hide();
        form.reset();
        showNote("You’re on the list. New posts will land in your inbox.");
      } catch {
        showNote(
          "Couldn’t subscribe right now. Try again, or use the <a href=\"/rss.xml\">RSS feed</a>.",
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Subscribe";
        }
      }
    });
  }

  setupSubscribe();
</script>
