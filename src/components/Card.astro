---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  showImage?: boolean;
}

const { variant = "h2", data, id, filePath, body } = Astro.props;
const { title, subtitle, description, pubDatetime } = data;
const path = getPath(id, filePath);

// nav.al date format: "Jul 2 2026" (no comma)
const date = pubDatetime
  .toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  })
  .replace(",", "");

const titleStyle = { viewTransitionName: slugifyStr(title) };

// Excerpt like nav.al: description, else first ~200 chars of body
const raw = (description?.trim() || body || "")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[#>*_`~]/g, "")
  .replace(/\s+/g, " ")
  .trim();
const excerpt =
  raw.length > 220 ? `${raw.slice(0, 220).replace(/\s+\S*$/, "")}` : raw;

const HeadingTag = variant;
---

<li class="blog-item">
  <HeadingTag class="blog-title" style={titleStyle}>
    <a href={path}>{title}</a>
  </HeadingTag>

  {subtitle && <p class="blog-subtitle">{subtitle}</p>}

  {
    excerpt && (
      <p class="blog-excerpt">
        {excerpt}
        {raw.length > 220 ? " " : " "}
        <a href={path} class="post-more-link">
          More ›
        </a>
      </p>
    )
  }

  <div class="blog-meta">
    <time datetime={pubDatetime.toISOString()}>{date}</time>
  </div>
</li>

<style>
  .blog-item {
    list-style: none;
    margin: 0 0 48px;
    padding: 0;
  }

  .blog-title {
    margin: 0 0 10px;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
    color: #fff;
  }

  .blog-title a {
    color: #fff;
  }

  .blog-title a:hover {
    color: #fff;
  }

  .blog-subtitle {
    margin: 0 0 10px;
    font-size: 18px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.88);
    font-weight: 500;
  }

  .blog-excerpt {
    margin: 0 0 12px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }

  .post-more-link {
    color: var(--more);
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
  }

  .post-more-link:hover {
    color: #fff;
  }

  .blog-meta {
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted-soft);
  }

  .blog-meta time {
    color: inherit;
  }
</style>
