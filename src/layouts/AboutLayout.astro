---
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header />
  <main id="main-content" class="site-shell about-page">
    <h1 class="page-title">{frontmatter.title}</h1>
    <hr class="page-rule" />
    <article class="prose">
      <slot />
    </article>
  </main>
</Layout>

<style>
  .about-page {
    padding-top: 36px;
    padding-bottom: 96px;
  }

  .page-title {
    margin: 0 0 12px;
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    color: #fff;
  }

  .page-rule {
    border: 0;
    border-top: 1px solid rgba(229, 229, 229, 0.2);
    margin: 0 0 32px;
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 30px;
    }
  }
</style>
