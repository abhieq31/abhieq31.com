---
import { type CollectionEntry, render } from "astro:content";
import Header from "@/components/Header.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getPath } from "@/utils/getPath";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  subtitle,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  heroImage,
} = post.data;

const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body ?? "");

const displayDate = pubDatetime
  .toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  })
  .replace(",", "");

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const postPath = getPath(post.id, post.filePath, true);
const computedCanonicalURL =
  canonicalURL ||
  (Astro.site
    ? new URL(postPath, Astro.site).href
    : new URL(postPath, Astro.url.origin).href);

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: computedCanonicalURL,
  ogImage,
  scrollSmooth: true,
};

const wordCount = (post.body ?? "").split(/\s+/).length;

// Related: share a tag, else nearest neighbors by date
const others = posts.filter(p => p.id !== post.id);
const tagSet = new Set(tags || []);
let related = others
  .map(p => ({
    post: p,
    score: (p.data.tags || []).filter(t => tagSet.has(t)).length,
  }))
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .map(x => x.post);

if (related.length < 3) {
  const fallback = others.filter(p => !related.some(r => r.id === p.id));
  related = [...related, ...fallback].slice(0, 3);
} else {
  related = related.slice(0, 3);
}
---

<Layout {...layoutProps}>
  <StructuredData
    type="BlogPosting"
    data={{
      title,
      description,
      author,
      pubDatetime,
      modDatetime,
      url: Astro.url.href,
      ogImage,
      tags,
      wordCount,
      readingTime,
    }}
  />
  <Header />

  <main id="main-content" class="site-shell post-page" data-pagefind-body>
    <header class="post-header">
      <p class="post-date">
        <time datetime={pubDatetime.toISOString()}>{displayDate}</time>
      </p>

      <h1 transition:name={slugifyStr(title)} class="post-title">
        {title}
      </h1>

      {
        subtitle ? (
          <p class="post-subtitle has-rule">{subtitle}</p>
        ) : (
          <hr class="post-rule" />
        )
      }
    </header>

    <article id="article" class="prose post-body">
      {
        heroImage && (
          <img
            src={heroImage}
            alt=""
            class="hero-img"
            loading="lazy"
          />
        )
      }
      <Content />
    </article>

    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore aria-label="Related">
          <h2 class="related-label">Related</h2>
          <ul class="related-grid">
            {related.map(r => {
              const d = r.data.pubDatetime
                .toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })
                .replace(",", "")
                .toUpperCase();
              return (
                <li>
                  <a href={getPath(r.id, r.filePath)} class="related-title">
                    {r.data.title}
                  </a>
                  <div class="related-date">{d}</div>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </main>
</Layout>

<script is:inline data-astro-rerun>
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("#article h2, #article h3, #article h4"),
    );
    for (const heading of headings) {
      if (!heading.id) continue;
      heading.classList.add("group");
      if (heading.querySelector(".heading-link")) continue;
      const link = document.createElement("a");
      link.className =
        "heading-link ml-2 opacity-0 group-hover:opacity-100 focus:opacity-100";
      link.href = "#" + heading.id;
      link.innerHTML = '<span aria-hidden="true">#</span>';
      heading.appendChild(link);
    }
  }

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));
    for (const codeBlock of codeBlocks) {
      if (codeBlock.querySelector(".copy-code")) continue;
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";
      const copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-muted px-2 py-1 text-xs leading-4 text-foreground font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);
      codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      copyButton.addEventListener("click", async () => {
        const code = codeBlock.querySelector("code");
        await navigator.clipboard.writeText(code?.innerText ?? "");
        copyButton.innerText = "Copied";
        setTimeout(() => {
          copyButton.innerText = copyButtonLabel;
        }, 700);
      });
    }
  }

  function addLazyLoading() {
    const article = document.querySelector("#article");
    if (!article) return;
    article.querySelectorAll("img:not([loading])").forEach((img) => {
      img.setAttribute("loading", "lazy");
    });
  }

  function processEmbeds() {
    const article = document.querySelector("#article");
    if (!article) return;
    const extractYouTubeId = (input) => {
      let videoId = input;
      try {
        if (videoId.includes("youtube.com/watch")) {
          videoId = new URL(videoId).searchParams.get("v") || "";
        } else if (videoId.includes("youtu.be/")) {
          videoId = videoId.split("youtu.be/")[1]?.split("?")[0] || "";
        } else if (videoId.includes("youtube.com/embed/")) {
          videoId = videoId.split("youtube.com/embed/")[1]?.split("?")[0] || "";
        }
      } catch (_) {}
      return videoId;
    };
    article.querySelectorAll("p").forEach((p) => {
      const text = (p.textContent || "").trim();
      const ytMatch = text.match(
        /\{% youtube (https:\/\/[^\s]+|[a-zA-Z0-9_-]+) %\}/,
      );
      if (ytMatch?.[1]) {
        const videoId = extractYouTubeId(ytMatch[1]);
        const container = document.createElement("div");
        container.className = "youtube-embed-container";
        container.innerHTML = `<iframe width="560" height="315" src="https://www.youtube.com/embed/${videoId}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        p.replaceWith(container);
      }
    });
  }

  addHeadingLinks();
  attachCopyButtons();
  addLazyLoading();
  processEmbeds();
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" }),
  );
</script>

<style>
  .post-page {
    padding-top: 28px;
    padding-bottom: 96px;
  }

  .post-header {
    margin-bottom: 32px;
  }

  .post-date {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
  }

  .post-title {
    margin: 0 0 14px;
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  /* nav.al: subtitle sits under title, then a rule before body */
  .post-subtitle {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
    color: #eeeeee;
    font-weight: 400;
  }

  .post-subtitle.has-rule {
    padding-bottom: 28px;
    margin-bottom: 0;
    border-bottom: 1px solid rgba(229, 229, 229, 0.25);
  }

  .post-rule {
    border: 0;
    border-top: 1px solid rgba(229, 229, 229, 0.25);
    margin: 8px 0 0;
  }

  .post-body {
    color: #eeeeee !important;
  }

  .hero-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 2rem;
  }

  .related {
    margin-top: 64px;
    padding-top: 8px;
  }

  .related-label {
    margin: 0 0 22px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
  }

  .related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 700px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .related-title {
    display: block;
    color: #fff;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .related-title:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-date {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.4);
  }

  .youtube-embed-container {
    margin: 2rem 0;
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }

  .youtube-embed-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: 30px;
    }

    .post-subtitle {
      font-size: 18px;
    }
  }
</style>
